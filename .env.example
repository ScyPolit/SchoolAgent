# Run `node scripts/bootstrap.js` to generate .env and a unique encryption secret.
# Keep PUBLIC_URL equal to the actual intranet/VPN origin used in links and emails.
PUBLIC_URL=http://localhost:8080
APP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
NODE_ENV=production
DATABASE_PATH=./data/school-agent.sqlite
ENCRYPTION_KEY_FILE=.secrets/encryption_key
COOKIE_SECURE=true
# 1 = container nginx only. Set to 2 when a school host HTTPS proxy is in front.
TRUST_PROXY_HOPS=1
ENABLE_DEMO_ADAPTER=false
# SMTP is configurable in the admin UI. These are optional initial values only.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
SMTP_FROM=
# Enter SMTP username/password through the administrator UI, where they are encrypted.
# Optional server-side Dify/Polymas credentials must be entered through admin UI.
# No external workflow key or administrator password belongs in this example.
